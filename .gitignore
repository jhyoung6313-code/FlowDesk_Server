# 의존성
node_modules/
backend/node_modules/
frontend/node_modules/

# 환경변수 (민감 정보)
.env
backend/.env

# TLS 인증서 · 개인키 (민감 정보)
certs/
*.key
*.crt
*.pem

# 빌드 결과물
dist/
build/
frontend/dist/

# 업로드 파일 (사용자 데이터, 바이너리)
backend/uploads/

# Claude Code 개인 설정 (settings.local.json·lock 등은 무시)
.claude/*
# 단, 기능 문서(Skill)는 팀 공유를 위해 버전관리에 포함
!.claude/commands/

# 임시 디자인 비교용 preview 파일
frontend/public/preview-*.html
frontend/public/preview-index.html

# 루트 디자인 mockup / 탐색용 HTML (repo 비포함)
/design-*.html
/v2-*.html
/dashboard-designs*.html
/sidebar-*.html
/login-designs-*.html
docs/*-mockup.html
*.pia

# 빌드 로그 출력물(아티팩트)
frontend/build.out.txt

# 매뉴얼 산출물(빌드 결과물) — 소스는 MANUAL.md
/FlowDesk_사용자메뉴얼.html

# 설치 패키지 압축 파일
*.zip

# OS
.DS_Store
Thumbs.db

