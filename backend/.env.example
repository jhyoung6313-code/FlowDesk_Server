# ── 데이터베이스 ────────────────────────────────────────────
# PostgreSQL
# 200명 동시접속 기준: connection_limit은 PostgreSQL postgresql.conf의 max_connections
# (기본 100)를 넘지 않게 설정한다. 백엔드를 단일 프로세스로 운영하면 이 값이 그대로
# Prisma 풀 크기가 되고, PM2 cluster 등으로 멀티 프로세스화하면 "프로세스 수 × connection_limit"이
# max_connections를 넘지 않도록 나눠서 잡아야 한다 (예: max_connections=200, 프로세스 4개 → 40).
DATABASE_URL="postgresql://postgres:password@localhost:5432/task_manager?connection_limit=40&pool_timeout=10"

# ── 인증 · 세션 (금융권 보안 정책) ──────────────────────────
JWT_SECRET="your-very-secret-key-change-this-in-production"
JWT_EXPIRES_IN="1h"            # 금융권 권고 30분~1시간
IDLE_TIMEOUT_MINUTES=30        # 유휴 세션 자동 로그아웃(분)
ENFORCE_OTP=true               # OTP 2단계 인증 전사 강제
# API_RATE_LIMIT_MAX=300        # IP당 분당 일반 API 요청 한도 (사용자가 프록시/NAT 한 대를 공유하면 올린다)
# LOGIN_RATE_LIMIT_MAX=10       # IP당 5분당 로그인 시도 한도
# DISABLE_SCHEDULERS=true       # cron 스케줄러 미등록 (같은 DB 를 쓰는 보조 인스턴스·테스트용 — 운영 본서버에서는 쓰지 않는다)
SINGLE_LOGIN_BLOCK=true        # 1계정 1로그인: 접속 중인 계정으로의 새 로그인을 거부 (false=새 로그인이 기존 세션 대체)
SESSION_ACTIVE_WINDOW_SEC=180  # '접속 중' 판단 기준(초). 로그아웃 없이 창을 닫으면 이 시간 후 재로그인 가능 (120 이상 권장)
BCRYPT_ROUNDS=12               # 비밀번호 해시 cost

# ── 민감정보 컬럼 암호화 (AES-256-GCM) ──────────────────────
# 32바이트(64 hex) 키. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 절대 git 에 커밋 금지. 키 분실 시 기존 암호화 데이터 복호화 불가
DATA_ENCRYPTION_KEY=""

# ── 계정 잠금 ────────────────────────────────────────────────
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=30

# ── 비밀번호 정책 ────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_CLASSES=3
PASSWORD_EXPIRE_DAYS=90
PASSWORD_HISTORY_COUNT=5

# ── 데이터 보유 · 자동 파기 ─────────────────────────────────
RETENTION_AUDIT_DAYS=1095       # 감사로그 3년(신용정보법)
RETENTION_SOFT_TASK_DAYS=90
RETENTION_NOTIFICATION_DAYS=90
RETENTION_PURGE_CRON="0 3 * * *"

# ── 비정상 접근 탐지 ─────────────────────────────────────────
ANOMALY_BULK_WINDOW=5
ANOMALY_BULK_THRESHOLD=100
ANOMALY_FORBIDDEN_WINDOW=5
ANOMALY_FORBIDDEN_THRESHOLD=10
ANOMALY_OFF_HOURS_START=0
ANOMALY_OFF_HOURS_END=6
ANOMALY_SCAN_CRON="*/5 * * * *"

# ── 백업 자동 스케줄링(F-44) ──────────────────────────────────
BACKUP_AUTO_ENABLED=true
BACKUP_AUTO_CRON="30 3 * * *"   # 매일 새벽 3:30
BACKUP_RETENTION_COUNT=14       # 로컬 보관 개수(초과분은 오래된 순으로 자동 삭제)

# ── 대규모 동시접속 확장(200명+) ────────────────────────────
# Socket.IO를 여러 인스턴스로 수평 확장할 때만 설정. 비워두면 기존처럼 단일 프로세스
# 인메모리 어댑터로 동작한다. 폐쇄망 내부에 Redis(또는 Memurai 등 Windows용 호환 서버)를
# 함께 설치해야 한다.
REDIS_URL=""

PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost"
