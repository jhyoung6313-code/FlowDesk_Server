// ── 감사로그 (접속기록·개인정보 처리이력) — 신용정보법 3년 보관 ──
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")            // 비로그인 실패 시 null
  username   String?  @db.VarChar(50)            // 사용자 삭제돼도 추적 가능하도록 별도 보관
  action     String   @db.VarChar(50)            // AUDIT_ACTION 상수
  resource   String?  @db.VarChar(100)           // 대상 리소스(엔드포인트/테이블)
  detail     String?                             // 부가 정보(JSON 문자열 등)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  success    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── 개인정보/신용정보 입력 차단 로그 ───────────────────────────
// 텍스트 입력에서 주민번호·카드번호·계좌번호·연락처(010) 등이 탐지되어
// 저장이 거부된 시도를 기록한다. 원문은 저장하지 않으며(관리자 포함 열람 불가),
// 기록 식별용 마스킹본(masked)만 남긴다.
model PiiBlockLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")            // 미인증 요청 시 null
  username   String?  @db.VarChar(50)            // 사용자 삭제돼도 추적 가능하도록 스냅샷
  piiType    String   @map("pii_type") @db.VarChar(30)  // 주민등록번호/신용카드번호/계좌번호/연락처
  fieldPath  String?  @map("field_path") @db.VarChar(100) // 탐지된 body 필드 경로
  masked     String?                             // 표시용 마스킹본(부분 비식별) — 원문 미저장
  endpoint   String?  @db.VarChar(120)           // 차단된 요청 METHOD PATH
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([piiType, createdAt])
  @@index([createdAt])
  @@map("pii_block_logs")
}

// ── 비밀번호 재사용 금지 이력 ──────────────────────────────
