  defaultParticipants String?   @map("default_participants") @db.Text
  createdBy   Int             @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  creator     User              @relation("PlaybookCreator", fields: [createdBy], references: [id])
  phases      PlaybookPhase[]
  steps       PlaybookStep[]
  runs        PlaybookRun[]
  versions    PlaybookVersion[]
  webhooks    PlaybookWebhook[]
  schedules   PlaybookSchedule[]

  @@map("playbooks")
}

model PlaybookPhase {
  id         Int            @id @default(autoincrement())
  playbookId Int            @map("playbook_id")
  name       String         @db.VarChar(100)
  color      String         @default("#1677ff") @db.VarChar(20)
  order      Int            @default(0)
  playbook   Playbook       @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  steps      PlaybookStep[]
  runSteps   RunStep[]

  @@map("playbook_phases")
}

model PlaybookStep {
  id              Int              @id @default(autoincrement())
  playbookId      Int              @map("playbook_id")
  phaseId         Int?             @map("phase_id")
  title           String           @db.VarChar(300)
  instructions    String?          @db.Text
  type            StepType         @default(task)
  order           Int              @default(0)
  estimatedMins   Int?             @map("estimated_mins")
  slaMins         Int?             @map("sla_mins")
  dueAt           DateTime?        @map("due_at")
  assigneeMode    StepAssigneeMode @default(unassigned) @map("assignee_mode")
  assigneeUserId  Int?             @map("assignee_user_id")
  assigneeRole    Role?            @map("assignee_role")
  requireEvidence Boolean          @default(false) @map("require_evidence")
  dependsOn       String?          @map("depends_on") @db.VarChar(500)
  decisionOptions String?          @map("decision_options") @db.Text
  parallelGroup   Int?             @map("parallel_group")
  playbook        Playbook         @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  phase           PlaybookPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assigneeUser    User?            @relation("StepAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  runSteps        RunStep[]

  @@map("playbook_steps")
}

model PlaybookRun {
  id             Int              @id @default(autoincrement())
  playbookId     Int?             @map("playbook_id")
  name           String           @db.VarChar(200)
  status         RunStatus        @default(active)
  severity       RunSeverity      @default(none)
  variableValues String?          @map("variable_values") @db.Text
  summary        String?          @db.Text
  ownerId        Int              @map("owner_id")
  createdBy      Int              @map("created_by")
  linkedRoomId   Int?             @map("linked_room_id")
  dueAt          DateTime?        @map("due_at")
  startedAt      DateTime         @default(now()) @map("started_at")
  endedAt        DateTime?        @map("ended_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  playbook       Playbook?        @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  owner          User             @relation("RunOwner", fields: [ownerId], references: [id])
  creator        User             @relation("RunCreator", fields: [createdBy], references: [id])
  steps          RunStep[]
  participants   RunParticipant[]
  updates        RunUpdate[]
  timeline       RunTimeline[]
  notifications  Notification[]   @relation("RunNotifications")

  @@map("playbook_runs")
}

model RunStep {
  id              Int           @id @default(autoincrement())
  runId           Int           @map("run_id")
  stepId          Int?          @map("step_id")
  phaseId         Int?          @map("phase_id")
  title           String        @db.VarChar(300)
  instructions    String?       @db.Text
  type            StepType      @default(task)
  order           Int           @default(0)
  status          RunStepStatus @default(pending)
  assigneeId      Int?          @map("assignee_id")
  dueAt           DateTime?     @map("due_at")
  slaMins         Int?          @map("sla_mins")
  requireEvidence Boolean       @default(false) @map("require_evidence")
  evidence        String?       @db.Text
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  completedBy     Int?          @map("completed_by")
  decisionChosen  String?       @map("decision_chosen") @db.VarChar(200)
  parallelGroup   Int?          @map("parallel_group")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  run             PlaybookRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  step            PlaybookStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)
  phase           PlaybookPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignee        User?          @relation("RunStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completer       User?          @relation("RunStepCompleter", fields: [completedBy], references: [id], onDelete: SetNull)
  checklists      RunStepChecklist[]
  notifications   Notification[]  @relation("RunStepNotifications")

  @@map("run_steps")
}

model RunParticipant {
  id       Int                @id @default(autoincrement())
  runId    Int                @map("run_id")
  userId   Int                @map("user_id")
  role     RunParticipantRole @default(participant)
  joinedAt DateTime           @default(now()) @map("joined_at")
  run      PlaybookRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  user     User               @relation("RunParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@map("run_participants")
}

model RunUpdate {
  id        Int           @id @default(autoincrement())
  runId     Int           @map("run_id")
  message   String        @db.Text
  type      RunUpdateType @default(note)
  createdBy Int           @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")
  run       PlaybookRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  creator   User          @relation("RunUpdateCreator", fields: [createdBy], references: [id])

  @@map("run_updates")
}

// Playbook/Run 활동(새 Run·Run 업데이트) 안읽음 추적: 사용자별 마지막 확인 시각
model PlaybookReadState {
  userId     Int      @id @map("user_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")
  user       User     @relation("PlaybookReadStateUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("playbook_read_states")
}

model RunTimeline {
  id        Int         @id @default(autoincrement())
  runId     Int         @map("run_id")
  eventType String      @map("event_type") @db.VarChar(50)
  eventData String?     @map("event_data") @db.Text
  createdBy Int?        @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  run       PlaybookRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  creator   User?       @relation("RunTimelineCreator", fields: [createdBy], references: [id])

  @@map("run_timeline")
}

model ScheduledChatMessage {
  id          Int      @id @default(autoincrement())
  roomId      Int      @map("room_id")
  senderId    Int      @map("sender_id")
  content     String   @db.Text
  scheduledAt DateTime @map("scheduled_at")
  sent        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User     @relation("ScheduledMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("scheduled_chat_messages")
}

// ───────────────────────── Playbook 확장 ─────────────────────────

model RunStepChecklist {
  id        Int      @id @default(autoincrement())
  runStepId Int      @map("run_step_id")
  content   String   @db.VarChar(500)
  checked   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  runStep   RunStep  @relation(fields: [runStepId], references: [id], onDelete: Cascade)

  @@map("run_step_checklists")
}

model PlaybookVersion {
  id         Int      @id @default(autoincrement())
  playbookId Int      @map("playbook_id")
  version    Int
  snapshot   String   @db.Text
  createdBy  Int      @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  creator    User     @relation("PlaybookVersionCreator", fields: [createdBy], references: [id])

  @@map("playbook_versions")
}

model PlaybookWebhook {
  id         Int      @id @default(autoincrement())
  playbookId Int      @map("playbook_id")
  name       String   @db.VarChar(200)
  token      String   @unique @db.VarChar(64)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@map("playbook_webhooks")
}

model PlaybookSchedule {
  id             Int            @id @default(autoincrement())
  playbookId     Int            @map("playbook_id")
  name           String         @db.VarChar(200)
  recurrenceType RecurrenceType @map("recurrence_type")
  recurrenceDay  Int?           @map("recurrence_day")
  recurrenceTime String         @default("09:00") @map("recurrence_time") @db.VarChar(5)
  variableValues String?        @map("variable_values") @db.Text
  participantIds String?        @map("participant_ids") @db.VarChar(500)
  isActive       Boolean        @default(true) @map("is_active")
  lastRunAt      DateTime?      @map("last_run_at")
  createdBy      Int            @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  playbook       Playbook       @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  creator        User           @relation("PlaybookScheduleCreator", fields: [createdBy], references: [id])

  @@map("playbook_schedules")
}

// ───────────────────────── BBS 게시판 ─────────────────────────

model BbsCategory {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(300)
  parentId    Int?          @map("parent_id")
  icon        String?       @db.VarChar(10)
  color       String?       @db.VarChar(30)
  order       Int           @default(0)
  writeRole   String        @default("all") @map("write_role") @db.VarChar(20)
  isActive    Boolean       @default(true) @map("is_active")
  showOnDashboard Boolean   @default(false) @map("show_on_dashboard")
  createdBy   Int           @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  parent      BbsCategory?  @relation("BbsCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    BbsCategory[] @relation("BbsCategoryTree")
  posts       BbsPost[]
  creator     User          @relation("BbsCategoryCreator", fields: [createdBy], references: [id])
  dashboardUsers UserDashboardBbsCategory[]

  @@map("bbs_categories")
}

model UserDashboardBbsCategory {
  userId     Int         @map("user_id")
  categoryId Int         @map("category_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   BbsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("user_dashboard_bbs_categories")
}

model BbsPost {
  id          Int             @id @default(autoincrement())
  categoryId  Int             @map("category_id")
  title       String          @db.VarChar(200)
  content     String          @db.Text
  senderOrg      String?      @map("sender_org") @db.VarChar(200)
  officialDueDate DateTime?   @map("official_due_date") @db.Date
  recipientDepts String[]     @map("recipient_depts")
  sensitivity String          @default("public") @db.VarChar(20) // public | internal | confidential (F-67)
  isPinned    Boolean         @default(false) @map("is_pinned")
  viewCount   Int             @default(0) @map("view_count")
  createdBy   Int             @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  delYn       String          @default("0") @map("del_yn") @db.Char(1)
  category    BbsCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  creator     User            @relation("BbsPostCreator", fields: [createdBy], references: [id])
  comments    BbsComment[]
  attachments BbsAttachment[]

  @@index([categoryId, delYn])
  @@map("bbs_posts")
}

model BbsComment {
  id          Int             @id @default(autoincrement())
  postId      Int             @map("post_id")
  parentId    Int?            @map("parent_id")
  userId      Int             @map("user_id")
  content     String          @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  delYn       String          @default("0") @map("del_yn") @db.Char(1)
  post        BbsPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      BbsComment?     @relation("BbsCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     BbsComment[]    @relation("BbsCommentReplies")
  user        User            @relation("BbsCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  attachments BbsAttachment[]

  @@map("bbs_comments")
}

model BbsAttachment {
  id           Int         @id @default(autoincrement())
  postId       Int         @map("post_id")
  commentId    Int?        @map("comment_id")
  uploadedBy   Int         @map("uploaded_by")
  originalName String      @map("original_name") @db.VarChar(255)
  storedName   String      @map("stored_name") @db.VarChar(255)
  mimeType     String      @map("mime_type") @db.VarChar(100)
  size         Int
  createdAt    DateTime    @default(now()) @map("created_at")
  post         BbsPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      BbsComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploader     User        @relation("BbsAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("bbs_attachments")
}

// ───────────────────────── 전자결재 ─────────────────────────

enum ApprovalStatus {
  draft
  pending
  approved
  rejected
  cancelled
}

enum ApprovalStepStatus {
  pending
  approved
  rejected
  skipped
}

model ApprovalFormType {
  id          Int               @id @default(autoincrement())
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(300)
  parentId    Int?              @map("parent_id")
  icon        String?           @db.VarChar(10)
  color       String?           @db.VarChar(30)
  order       Int               @default(0)
  isActive    Boolean           @default(true) @map("is_active")
  createdBy   Int               @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  parent      ApprovalFormType?  @relation("ApprovalFormTypeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ApprovalFormType[] @relation("ApprovalFormTypeTree")
  templates   ApprovalTemplate[]
  creator     User              @relation("ApprovalFormTypeCreator", fields: [createdBy], references: [id])

  @@map("approval_form_types")
}

model ApprovalTemplate {
  id          Int              @id @default(autoincrement())
  formTypeId  Int              @map("form_type_id")
  name        String           @db.VarChar(200)
  description String?          @db.VarChar(500)
  fieldsJson  String           @map("fields_json") @db.Text
  lineJson    String?          @map("line_json") @db.Text
  code        String           @default("DOC") @db.VarChar(10)
  isActive    Boolean          @default(true) @map("is_active")
  createdBy   Int              @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  formType    ApprovalFormType @relation(fields: [formTypeId], references: [id], onDelete: Cascade)
  creator     User             @relation("ApprovalTemplateCreator", fields: [createdBy], references: [id])
  documents   ApprovalDocument[]

  @@map("approval_templates")
}

model ApprovalDocument {
  id          Int                  @id @default(autoincrement())
  templateId  Int                  @map("template_id")
  title       String               @db.VarChar(200)
  formData    String               @map("form_data") @db.Text
  status      ApprovalStatus       @default(draft)
  currentStep Int                  @default(0) @map("current_step")
  totalSteps  Int                  @default(0) @map("total_steps")
  docNo        String?             @map("doc_no") @db.VarChar(30)
  rejectedStep Int?                @map("rejected_step")
  isUrgent    Boolean              @default(false) @map("is_urgent")
  dueDate     DateTime?            @map("due_date")
  createdBy   Int                  @map("created_by")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  delYn       String               @default("0") @map("del_yn") @db.Char(1)
  template    ApprovalTemplate     @relation(fields: [templateId], references: [id])
  creator     User                 @relation("ApprovalDocumentCreator", fields: [createdBy], references: [id])
  steps       ApprovalStep[]
  attachments ApprovalAttachment[]
  comments    ApprovalComment[]

  @@index([createdBy, delYn])
  @@index([docNo])
  @@map("approval_documents")
}

model ApprovalDocSeq {
  formCode String @map("form_code") @db.VarChar(10)
  year     Int
  seq      Int    @default(0)

  @@id([formCode, year])
  @@map("approval_doc_seq")
}

model ApprovalStep {
  id         Int                @id @default(autoincrement())
  documentId Int                @map("document_id")
  stepOrder  Int                @map("step_order")
  approverId Int                @map("approver_id")
  type       String             @default("approval")
  status     ApprovalStepStatus @default(pending)
  comment    String?            @db.VarChar(500)
  actionAt   DateTime?          @map("action_at")
  approverNameSnap  String?     @map("approver_name_snap")  @db.VarChar(100)
  approverTitleSnap String?     @map("approver_title_snap") @db.VarChar(100)
  signImagePath     String?     @map("sign_image_path")     @db.VarChar(255)
  signedIp          String?     @map("signed_ip")           @db.VarChar(45)
  actingType        String?     @map("acting_type")         @db.VarChar(10)
  createdAt  DateTime           @default(now()) @map("created_at")
  document   ApprovalDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver   User               @relation("ApprovalStepApprover", fields: [approverId], references: [id])

  @@index([documentId, stepOrder])
  @@map("approval_steps")
}

model ApprovalAttachment {
  id           Int              @id @default(autoincrement())
  documentId   Int              @map("document_id")
  uploadedBy   Int              @map("uploaded_by")
  originalName String           @map("original_name") @db.VarChar(255)
  storedName   String           @map("stored_name") @db.VarChar(255)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  size         Int
  createdAt    DateTime         @default(now()) @map("created_at")
  document     ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader     User             @relation("ApprovalAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("approval_attachments")
}

model ApprovalComment {
  id         Int              @id @default(autoincrement())
  documentId Int              @map("document_id")
  userId     Int              @map("user_id")
  content    String           @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  document   ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User             @relation("ApprovalCommentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("approval_comments")
}

// ── 사내 메일 ────────────────────────────────────────────────

model InternalMail {
  id           Int      @id @default(autoincrement())
  fromUserId   Int      @map("from_user_id")
  subject      String   @db.VarChar(300)
  body         String   @db.Text
  isDraft      Boolean  @default(false) @map("is_draft")
  priority     String   @default("normal") @db.VarChar(10)  // normal | urgent
  parentId     Int?     @map("parent_id")   // 답장/전달 원본
  threadId     Int?     @map("thread_id")   // 대화 스레드 루트 메일 id
  forwardedFrom Int?    @map("forwarded_from")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  from         User                    @relation("MailSender", fields: [fromUserId], references: [id])
  recipients   InternalMailRecipient[]
  attachments  InternalMailAttachment[]
  comments     InternalMailComment[]
  labelLinks   InternalMailLabelLink[]

  @@map("internal_mails")
}

model InternalMailLabel {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(50)
  color     String   @default("#1677ff") @db.VarChar(20)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User                    @relation("MailLabelOwner", fields: [userId], references: [id])
  links     InternalMailLabelLink[]

  @@map("internal_mail_labels")
}

model InternalMailLabelLink {
  id       Int @id @default(autoincrement())
  labelId  Int @map("label_id")
  mailId   Int @map("mail_id")

  label    InternalMailLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  mail     InternalMail      @relation(fields: [mailId], references: [id], onDelete: Cascade)

  @@unique([labelId, mailId])
  @@map("internal_mail_label_links")
}

model InternalMailComment {
  id        Int      @id @default(autoincrement())
  mailId    Int      @map("mail_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mail      InternalMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  user      User         @relation("MailCommentUser", fields: [userId], references: [id])

  @@map("internal_mail_comments")
}

model InternalMailRecipient {
  id        Int       @id @default(autoincrement())
  mailId    Int       @map("mail_id")
  userId    Int       @map("user_id")
  type      String    @default("to") @db.VarChar(10)  // to | cc | bcc
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  isStarred Boolean   @default(false) @map("is_starred")
  folder    String    @default("inbox") @db.VarChar(20) // inbox | trash
  deletedAt DateTime? @map("deleted_at")

  mail      InternalMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  user      User         @relation("MailRecipient", fields: [userId], references: [id])

  @@unique([mailId, userId])
  @@map("internal_mail_recipients")
}

model InternalMailAttachment {
  id           Int      @id @default(autoincrement())
  mailId       Int      @map("mail_id")
  uploadedBy   Int      @map("uploaded_by")
  originalName String   @map("original_name") @db.VarChar(500)
  storedName   String   @map("stored_name") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  mail         InternalMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  uploader     User         @relation("MailAttachmentUploader", fields: [uploadedBy], references: [id])

  @@map("internal_mail_attachments")
}

// ─────────────────────────────────────────────────────────────
// F-58 AI 어시스턴트 — 사용량/비용 추적 (append-only)
// 프롬프트 원문은 저장하지 않는다(PII 유출 방지). 집계 지표만 적재.
// ─────────────────────────────────────────────────────────────
model AiUsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  username  String?  @db.VarChar(50)
  feature   String   @db.VarChar(30) // task_gen | weekly_summary
  model     String?  @db.VarChar(50)
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation("AiUsageUser", fields: [userId], references: [id], onDelete: SetNull)

  @@map("ai_usage_logs")
}

// ─────────────────────────────────────────────────────────────
// F-59 협업 위키/문서 — 스페이스 → 문서(트리) + 버전 이력 + 댓글
// 문서 본문은 RichEditor(TipTap) HTML을 content(Text)로 저장.
// ─────────────────────────────────────────────────────────────
model WikiSpace {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  icon       String?   @db.VarChar(20)
  color      String?   @db.VarChar(20)
  visibility String    @default("public") @db.VarChar(20) // public | private
  sortOrder  Int       @default(0) @map("sort_order")
  createdBy  Int       @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  creator    User      @relation("WikiSpaceCreator", fields: [createdBy], references: [id])
  docs       WikiDoc[]

  @@map("wiki_spaces")
}

model WikiDoc {
  id         Int       @id @default(autoincrement())
  spaceId    Int       @map("space_id")
  parentId   Int?      @map("parent_id")
  title      String    @default("제목 없음") @db.VarChar(200)
  content    String?   @db.Text
  icon       String?   @db.VarChar(20)
  isFavorite Boolean   @default(false) @map("is_favorite")
  sensitivity String   @default("public") @db.VarChar(20) // public | internal | confidential (F-67)
  sortOrder  Int       @default(0) @map("sort_order")
  createdBy  Int       @map("created_by")
  updatedBy  Int?      @map("updated_by")
  delYn      String    @default("0") @map("del_yn") @db.Char(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  space      WikiSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent     WikiDoc?  @relation("WikiDocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   WikiDoc[] @relation("WikiDocTree")
  creator    User      @relation("WikiDocCreator", fields: [createdBy], references: [id])
  versions   WikiDocVersion[]
  comments   WikiDocComment[]

  @@map("wiki_docs")
}

model WikiDocVersion {
  id        Int      @id @default(autoincrement())
  docId     Int      @map("doc_id")
  title     String   @db.VarChar(200)
  content   String?  @db.Text
  editedBy  Int      @map("edited_by")
  createdAt DateTime @default(now()) @map("created_at")
  doc       WikiDoc  @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@map("wiki_doc_versions")
}

model WikiDocComment {
  id        Int      @id @default(autoincrement())
  docId     Int      @map("doc_id")
  content   String   @db.Text
  createdBy Int      @map("created_by")
  delYn     String   @default("0") @map("del_yn") @db.Char(1)
  createdAt DateTime @default(now()) @map("created_at")
  doc       WikiDoc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  author    User     @relation("WikiCommentAuthor", fields: [createdBy], references: [id])

  @@map("wiki_doc_comments")
}

// ─────────────────────────────────────────────────────────────
// F-61 회의 관리 — 안건 · 참석자(RSVP) · 회의록 · 결정사항 · 액션아이템(→업무 전환)
// 회의록 본문은 RichEditor(TipTap) HTML을 minutes(Text)로 저장.
// ─────────────────────────────────────────────────────────────
model Meeting {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(200)
  startAt     DateTime  @map("start_at")
  endAt       DateTime? @map("end_at")
  location    String?   @db.VarChar(200)
  organizerId Int       @map("organizer_id")
  status      String    @default("scheduled") @db.VarChar(20) // scheduled | in_progress | done | cancelled
  minutes     String?   @db.Text
  summary     String?   @db.Text // AI 요약(F-58 연계, 선택)
  delYn       String    @default("0") @map("del_yn") @db.Char(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organizer   User      @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  agenda      MeetingAgenda[]
  attendees   MeetingAttendee[]
  decisions   MeetingDecision[]
  actionItems MeetingActionItem[]

  @@map("meetings")
}

model MeetingAgenda {
  id          Int     @id @default(autoincrement())
  meetingId   Int     @map("meeting_id")
  sortOrder   Int     @default(0) @map("sort_order")
  title       String  @db.VarChar(300)
  presenterId Int?    @map("presenter_id")
  durationMin Int?    @map("duration_min")
  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_agenda")
}

model MeetingAttendee {
  id        Int     @id @default(autoincrement())
  meetingId Int     @map("meeting_id")
  userId    Int?    @map("user_id")   // 내부 참석자
  extName   String? @map("ext_name") @db.VarChar(100) // 외부 참석자(자유 텍스트)
  role      String  @default("attendee") @db.VarChar(20) // organizer | attendee | optional
  rsvp      String  @default("invited") @db.VarChar(20)  // invited | accepted | declined | attended | absent
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User?   @relation("MeetingAttendee", fields: [userId], references: [id], onDelete: Cascade)

  @@map("meeting_attendees")
}

model MeetingDecision {
  id        Int      @id @default(autoincrement())
  meetingId Int      @map("meeting_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_decisions")
}

model MeetingActionItem {
  id         Int       @id @default(autoincrement())
  meetingId  Int       @map("meeting_id")
  content    String    @db.VarChar(500)
  assigneeId Int?      @map("assignee_id")
  dueDate    DateTime? @map("due_date") @db.Date
  taskId     Int?      @map("task_id")   // 업무 전환 시 연결
  status     String    @default("open") @db.VarChar(20) // open | done
  createdAt  DateTime  @default(now()) @map("created_at")
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee   User?     @relation("MeetingActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("meeting_action_items")
}

// ─────────────────────────────────────────────────────────────
// F-60 OKR/목표 관리 — 주기 · 목표(Objective) · 핵심결과(KeyResult) · 체크인 · 연결
// 진척: KR progress = (current-start)/(target-start) 클램프, Objective = KR 평균.
// ─────────────────────────────────────────────────────────────
model OkrCycle {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(50) // '2026 Q3'
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  objectives Objective[]

  @@map("okr_cycles")
}

model Objective {
  id         Int        @id @default(autoincrement())
  cycleId    Int        @map("cycle_id")
  parentId   Int?       @map("parent_id") // 상위 목표 정렬
  title      String     @db.VarChar(300)
  description String?    @db.Text
  scope      String     @default("team") @db.VarChar(20) // company | dept | team | personal
  scopeRefId Int?       @map("scope_ref_id") // 부서/팀 id (scope에 따라)
  ownerId    Int        @map("owner_id")
  status     String     @default("on_track") @db.VarChar(20) // on_track | at_risk | off_track
  progress   Int        @default(0) // 0~100 (KR 평균, 자동 계산)
  delYn      String     @default("0") @map("del_yn") @db.Char(1)
  createdAt  DateTime   @default(now()) @map("created_at")
  cycle      OkrCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  parent     Objective? @relation("ObjectiveTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Objective[] @relation("ObjectiveTree")
  owner      User       @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  keyResults KeyResult[]

  @@map("objectives")
}

model KeyResult {
  id           Int      @id @default(autoincrement())
  objectiveId  Int      @map("objective_id")
  title        String   @db.VarChar(300)
  metricType   String   @default("percent") @map("metric_type") @db.VarChar(20) // number | percent | boolean
  startValue   Decimal  @default(0) @map("start_value") @db.Decimal(14, 2)
  targetValue  Decimal  @default(100) @map("target_value") @db.Decimal(14, 2)
  currentValue Decimal  @default(0) @map("current_value") @db.Decimal(14, 2)
  autoProgress Boolean  @default(false) @map("auto_progress") // 연결 업무 완료율로 자동 계산
  ownerId      Int?     @map("owner_id")
  createdAt    DateTime @default(now()) @map("created_at")
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner        User?     @relation("KeyResultOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  links        KeyResultLink[]
  checkins     KeyResultCheckin[]

  @@map("key_results")
}

model KeyResultLink {
  id          Int       @id @default(autoincrement())
  keyResultId Int       @map("key_result_id")
  refType     String    @map("ref_type") @db.VarChar(20) // task | board_card | wbs_task
  refId       Int       @map("ref_id")
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@map("key_result_links")
}

model KeyResultCheckin {
  id          Int       @id @default(autoincrement())
  keyResultId Int       @map("key_result_id")
  value       Decimal   @db.Decimal(14, 2)
  confidence  Int?      // 1~10
  comment     String?   @db.VarChar(500)
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  author      User      @relation("OkrCheckinAuthor", fields: [createdBy], references: [id])

  @@map("key_result_checkins")
}

// ───────────────────────── Automation (범용 자동화 규칙 엔진, F-62) ─────────────────────────
// M365 Power Automate 경량판. 전역 이벤트(업무/결재/게시판 등) → 조건 → 액션(알림/이메일/채팅/웹훅/업무생성).
// 기존 모델을 건드리지 않는 순수 추가(additive) 설계. createdBy는 FK 관계 없이 Int로만 보관(BoardAutomation과 동일한 경량 패턴).
model AutomationRule {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(200)
  description String?          @db.VarChar(500)
  isActive    Boolean          @default(true) @map("is_active")
  event       String           @db.VarChar(60)   // 예: task.created, task.status_changed, approval.approved
  conditions  String?          @db.Text          // JSON 배열: [{ field, op, value }]
  actions     String           @db.Text          // JSON 배열: [{ type, config }]
  runCount    Int              @default(0) @map("run_count")
  lastRunAt   DateTime?        @map("last_run_at")
  lastError   String?          @map("last_error") @db.VarChar(500)
  createdBy   Int              @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  logs        AutomationLog[]

  @@index([event, isActive])
  @@map("automation_rules")
}

model AutomationLog {
  id        Int            @id @default(autoincrement())
  ruleId    Int            @map("rule_id")
  event     String         @db.VarChar(60)
  status    String         @db.VarChar(20)  // success | failed | skipped
  detail    String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@map("automation_logs")
}

// ───────────────────────── Forms (설문/투표, F-66) ─────────────────────────
// M365 Forms 대응. 설문 → 문항 → 응답 → 문항응답. createdBy/respondentId는 경량 Int(FK 미사용).
model Form {
  id            Int            @id @default(autoincrement())
  title         String         @db.VarChar(200)
  description   String?        @db.VarChar(1000)
  status        String         @default("draft") @db.VarChar(20) // draft | open | closed
  anonymous     Boolean        @default(false)   // 익명 응답
  multiResponse Boolean        @default(false) @map("multi_response") // 재응답 허용
  createdBy     Int            @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  delYn         String         @default("0") @map("del_yn") @db.Char(1)
  fields        FormField[]
  responses     FormResponse[]

  @@index([status, delYn])
  @@map("forms")
}

model FormField {
  id       Int          @id @default(autoincrement())
  formId   Int          @map("form_id")
  order    Int          @default(0)
  type     String       @db.VarChar(20) // text | textarea | single | multiple | rating | number | date
  label    String       @db.VarChar(300)
  required Boolean      @default(false)
  options  String?      @db.Text        // 선택형 보기(JSON 배열)
  form     Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers  FormAnswer[]

  @@index([formId, order])
  @@map("form_fields")
}

model FormResponse {
  id           Int          @id @default(autoincrement())
  formId       Int          @map("form_id")
  respondentId Int?         @map("respondent_id") // 익명이면 null
  createdAt    DateTime     @default(now()) @map("created_at")
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers      FormAnswer[]

  @@index([formId])
  @@map("form_responses")
}

model FormAnswer {
  id         Int          @id @default(autoincrement())
  responseId Int          @map("response_id")
  fieldId    Int          @map("field_id")
  value      String?      @db.Text // 텍스트/숫자/날짜; 다중선택은 JSON 배열 문자열
  response   FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field      FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([fieldId])
  @@map("form_answers")
}
