generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique @db.VarChar(50)
  passwordHash     String            @map("password_hash") @db.VarChar(255)
  displayName      String            @map("display_name") @db.VarChar(100)
  role             Role              @default(member)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  totpEnabled      Boolean           @default(false) @map("totp_enabled")
  totpSecret       String?           @map("totp_secret") @db.VarChar(255)
  avatarColor      String?           @map("avatar_color") @db.VarChar(20)
  statusEmoji      String?           @map("status_emoji") @db.VarChar(10)
  statusText       String?           @map("status_text") @db.VarChar(100)
  // ── 조직 정보 (부서·팀은 관리자 지정, 직책·직급은 본인 편집) ───────────────
  departmentId     Int?              @map("department_id")
  teamId           Int?              @map("team_id")
  department       Department?       @relation("UserDepartment", fields: [departmentId], references: [id])
  team             Team?             @relation("UserTeam", fields: [teamId], references: [id])
  position         String?           @map("position") @db.VarChar(100)
  jobGrade         String?           @map("job_grade") @db.VarChar(100)
  signImagePath    String?           @map("sign_image_path") @db.VarChar(255)
  sealImagePath    String?           @map("seal_image_path") @db.VarChar(255)
  // ── 미사용 화면 잠금 시간(분). 0 = 사용 안 함 ──────────
  idleTimeoutMin   Int               @default(60) @map("idle_timeout_min")
  // ── 권한 그룹(조합형) — role(admin/member)과 별개로 추가 부여하는 권한 집합 ──
  // 예: 일반사용자(member) + 'PII_AUDIT'(감사권한). PERMISSIONS 레지스트리로 확장.
  // 직무분리(ISMS-P): 시스템 관리자여도 해당 권한이 없으면 그 기능을 쓸 수 없다.
  permissions      String[]          @default([])
  // ── 금융권 보안 정책 필드 ──────────────────────────────
  failedLoginCount Int               @default(0) @map("failed_login_count")
  lockedUntil      DateTime?         @map("locked_until")
  passwordChangedAt DateTime         @default(now()) @map("password_changed_at")
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  lastLoginAt      DateTime?         @map("last_login_at")
  lastLoginIp      String?           @map("last_login_ip") @db.VarChar(45)
  sessionNonce     String?           @map("session_nonce") @db.VarChar(64)
  passwordHistories PasswordHistory[]
  auditLogs        AuditLog[]
  piiBlockLogs     PiiBlockLog[]
  calendarNotes    CalendarNote[]    @relation("CalendarNoteCreator")
  memos            Memo[]            @relation("MemoCreator")
  milestones       Milestone[]
  notifications    Notification[]
  notificationsActed Notification[]  @relation("NotificationActor")
  recurringTasks   RecurringTask[]
  assignedTasks    TaskAssignee[]
  taskAttachments  TaskAttachment[]  @relation("AttachmentUploader")
  taskComments     TaskComment[]
  taskHistories    TaskHistory[]     @relation("HistoryUser")
  taskTemplates    TaskTemplate[]
  createdTasks     Task[]            @relation("TaskCreator")
  timeEntries      TimeEntry[]
  ledgerEntries    LedgerEntry[]
  ledgerRecurrings LedgerRecurring[]
  wbsIssues         WbsIssue[]             @relation("WbsIssueCreator")
  wbsProjects       WbsProject[]           @relation("WbsProjectCreator")
  chatRoomsCreated  ChatRoom[]             @relation("ChatRoomCreator")
  chatMemberships   ChatRoomMember[]       @relation("ChatRoomMemberships")
  chatMessages      ChatMessage[]          @relation("ChatMessageSender")
  chatReactions     ChatMessageReaction[]  @relation("ChatReactions")
  chatSaved              ChatSavedMessage[]     @relation("ChatSavedMessages")
  chatPinned             ChatPinnedMessage[]    @relation("ChatPinnedMessages")
  scheduledChatMessages  ScheduledChatMessage[] @relation("ScheduledMessages")
  boardCategories      BoardCategory[]        @relation("BoardCategoryCreator")
  boardsCreated        Board[]                @relation("BoardCreator")
  boardMembers         BoardMember[]
  boardCards           BoardCard[]            @relation("BoardCardCreator")
  boardViewsCreated    BoardView[]            @relation("BoardViewCreator")
  boardCardAssignees   BoardCardAssignee[]
  boardCardComments    BoardCardComment[]
  boardCardAttachments BoardCardAttachment[]  @relation("BoardCardAttachmentUploader")
  playbooksCreated     Playbook[]             @relation("PlaybookCreator")
  playbookStepsAssigned PlaybookStep[]        @relation("StepAssigneeUser")
  runsOwned            PlaybookRun[]          @relation("RunOwner")
  runsCreated          PlaybookRun[]          @relation("RunCreator")
  runStepsAssigned     RunStep[]              @relation("RunStepAssignee")
  runStepsCompleted    RunStep[]              @relation("RunStepCompleter")
  runParticipations    RunParticipant[]       @relation("RunParticipants")
  runUpdates           RunUpdate[]            @relation("RunUpdateCreator")
  runTimelineEvents    RunTimeline[]          @relation("RunTimelineCreator")
  playbookVersions     PlaybookVersion[]      @relation("PlaybookVersionCreator")
  playbookSchedules    PlaybookSchedule[]     @relation("PlaybookScheduleCreator")
  playbookReadState    PlaybookReadState?     @relation("PlaybookReadStateUser")
  bbsCategoriesCreated BbsCategory[]          @relation("BbsCategoryCreator")
  bbsPosts             BbsPost[]              @relation("BbsPostCreator")
  bbsComments          BbsComment[]           @relation("BbsCommentUser")
  bbsAttachments       BbsAttachment[]        @relation("BbsAttachmentUploader")
  approvalFormTypes    ApprovalFormType[]     @relation("ApprovalFormTypeCreator")
  approvalTemplates    ApprovalTemplate[]     @relation("ApprovalTemplateCreator")
  approvalDocuments    ApprovalDocument[]     @relation("ApprovalDocumentCreator")
  approvalSteps        ApprovalStep[]         @relation("ApprovalStepApprover")
  approvalComments     ApprovalComment[]      @relation("ApprovalCommentUser")
  approvalAttachments  ApprovalAttachment[]   @relation("ApprovalAttachmentUploader")
  sentMails            InternalMail[]         @relation("MailSender")
  mailRecipients       InternalMailRecipient[] @relation("MailRecipient")
  mailAttachments      InternalMailAttachment[] @relation("MailAttachmentUploader")
  mailComments         InternalMailComment[]   @relation("MailCommentUser")
  mailLabels           InternalMailLabel[]     @relation("MailLabelOwner")
  dashboardBbsCategories UserDashboardBbsCategory[]
  scheduleEventsCreated  ScheduleEvent[]         @relation("ScheduleEventCreator")
  scheduleAssignments    ScheduleEventAssignee[]
  scheduleShares         ScheduleEventShare[]
  aiUsageLogs            AiUsageLog[]            @relation("AiUsageUser")
  wikiSpaces             WikiSpace[]             @relation("WikiSpaceCreator")
  wikiDocs               WikiDoc[]               @relation("WikiDocCreator")
  wikiComments           WikiDocComment[]        @relation("WikiCommentAuthor")
  meetingsOrganized      Meeting[]               @relation("MeetingOrganizer")
  meetingAttendances     MeetingAttendee[]       @relation("MeetingAttendee")
  meetingActionItems     MeetingActionItem[]     @relation("MeetingActionAssignee")
  objectivesOwned        Objective[]             @relation("ObjectiveOwner")
  keyResultsOwned        KeyResult[]             @relation("KeyResultOwner")
  okrCheckins            KeyResultCheckin[]      @relation("OkrCheckinAuthor")

  @@map("users")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  teams       Team[]
  users       User[]   @relation("UserDepartment")

  @@map("departments")
}

model Team {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(100)
  departmentId   Int             @map("department_id")
  description    String?
  order          Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at")
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users          User[]          @relation("UserTeam")
  recurringTasks RecurringTask[]
  taskTemplates  TaskTemplate[]
  tasks          Task[]

  @@unique([departmentId, name])
  @@map("teams")
}

model Task {
  id              Int                 @id @default(autoincrement())
  title           String              @db.VarChar(200)
  description     String?
  partId          Int?                @map("part_id")
  priority        Priority            @default(normal)
  status          Status              @default(pending)
  startDate       DateTime?           @map("start_date") @db.Date
  dueDate         DateTime?           @map("due_date") @db.Date
  createdBy       Int                 @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  delYn           String              @default("0") @map("del_yn") @db.Char(1)
  recurringTaskId Int?                @map("recurring_task_id")
  notifications   Notification[]
  assignees       TaskAssignee[]
  attachments     TaskAttachment[]
  comments        TaskComment[]
  successors      TaskDependency[]    @relation("Predecessor")
  predecessors    TaskDependency[]    @relation("Successor")
  extraAssignees  TaskExtraAssignee[]
  histories       TaskHistory[]
  tags            TaskTag[]
  creator         User                @relation("TaskCreator", fields: [createdBy], references: [id])
  part            Team?               @relation(fields: [partId], references: [id])
  recurringTask   RecurringTask?      @relation(fields: [recurringTaskId], references: [id])
  timeEntries     TimeEntry[]
  boardCards      BoardCard[]

  @@map("tasks")
}

model TaskExtraAssignee {
  id     Int    @id @default(autoincrement())
  taskId Int    @map("task_id")
  name   String @db.VarChar(100)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_extra_assignees")
}

model TaskAssignee {
  taskId     Int      @map("task_id")
  userId     Int      @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

model TaskDependency {
  id            Int            @id @default(autoincrement())
  predecessorId Int            @map("predecessor_id")
  successorId   Int            @map("successor_id")
  type          DependencyType @default(finish_to_start)
  predecessor   Task           @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Task           @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@map("task_dependencies")
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  taskId     Int?             @map("task_id")
  runId      Int?             @map("run_id")
  runStepId  Int?             @map("run_step_id")
  actorId    Int?             @map("actor_id")
  link       String?          @db.VarChar(300)
  message    String?          @db.VarChar(500)
  type       NotificationType
  isRead     Boolean          @default(false) @map("is_read")
  delYn      String           @default("0") @map("del_yn") @db.Char(1)
  createdAt  DateTime         @default(now()) @map("created_at")
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run        PlaybookRun?     @relation("RunNotifications", fields: [runId], references: [id], onDelete: Cascade)
  runStep    RunStep?         @relation("RunStepNotifications", fields: [runStepId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments TaskAttachment[]

  @@map("task_comments")
}

model TaskAttachment {
  id           Int          @id @default(autoincrement())
  taskId       Int          @map("task_id")
  commentId    Int?         @map("comment_id")
  uploadedBy   Int          @map("uploaded_by")
  originalName String       @map("original_name") @db.VarChar(255)
  storedName   String       @map("stored_name") @db.VarChar(255)
  mimeType     String       @map("mime_type") @db.VarChar(100)
  size         Int
  createdAt    DateTime     @default(now()) @map("created_at")
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment      TaskComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploader     User         @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

model TaskHistory {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  action    String   @db.VarChar(50)
  field     String?  @db.VarChar(100)
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("HistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_histories")
}

model CalendarNote {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  content   String   @db.VarChar(200)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  creator   User     @relation("CalendarNoteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("calendar_notes")
}

/// 개인 메모지 (포스트잇 보드형 / 사이드 메모형 공용 데이터)
model Memo {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(200)
  content   String   @db.Text
  color     String   @default("yellow") @db.VarChar(20)
  pinned    Boolean  @default(false)
  posX      Int      @default(0) @map("pos_x")
  posY      Int      @default(0) @map("pos_y")
  sortOrder Int      @default(0) @map("sort_order")
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  creator   User     @relation("MemoCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@map("memos")
}

/// 자원(회의실 · 법인차량) 마스터 — 일정에서 예약 대상으로 연결
model ScheduleResource {
  id          Int             @id @default(autoincrement())
  kind        String          @db.VarChar(20)   // 'room' | 'vehicle'
  name        String          @db.VarChar(100)
  description String?         @db.VarChar(200)   // 정원/차종/번호판 등
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  events      ScheduleEvent[] @relation("ScheduleEventResource")

  @@index([kind])
  @@map("schedule_resources")
}

/// 일자별 일정(휴가/반차/회의/외근/출장/재택/차량 등) — 날짜 단위 표시
model ScheduleEvent {
  id         Int                     @id @default(autoincrement())
  type       String                  @db.VarChar(20)   // vacation/half_day/meeting/field_work/business_trip/remote/vehicle/etc
  title      String?                 @db.VarChar(200)
  startDate  DateTime                @map("start_date") @db.Date
  endDate    DateTime                @map("end_date") @db.Date
  allDay     Boolean                 @default(true) @map("all_day")
  startTime  String?                 @map("start_time") @db.VarChar(5)   // 'HH:mm'
  endTime    String?                 @map("end_time") @db.VarChar(5)
  location   String?                 @db.VarChar(200)
  memo       String?                 @db.VarChar(500)
  visibility String                  @default("public") @db.VarChar(10)   // public(전체공개) | shared(지정공유) | private(비공개)
  resourceId Int?                    @map("resource_id")
  resource   ScheduleResource?       @relation("ScheduleEventResource", fields: [resourceId], references: [id], onDelete: SetNull)
  createdBy  Int                     @map("created_by")
  creator    User                    @relation("ScheduleEventCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  assignees   ScheduleEventAssignee[]
  shares      ScheduleEventShare[]
  shareScopes ScheduleEventShareScope[]

  @@index([startDate, endDate])
  @@index([type])
  @@map("schedule_events")
}

/// 일정 대상자 (타인 다중 지정 가능)
model ScheduleEventAssignee {
  eventId Int           @map("event_id")
  userId  Int           @map("user_id")
  event   ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("schedule_event_assignees")
}

/// 일정 공유자 (주체는 아니지만 열람/알림 대상)
model ScheduleEventShare {
  eventId Int           @map("event_id")
  userId  Int           @map("user_id")
  event   ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("schedule_event_shares")
}

/// 일정 공유 범위 — 부서/팀 단위 공유 (인원 변동 자동 반영). refId는 Department/Team id의 loose 참조
model ScheduleEventShareScope {
  eventId Int           @map("event_id")
  kind    String        @db.VarChar(10)   // 'dept' | 'team'
  refId   Int           @map("ref_id")
  event   ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, kind, refId])
  @@index([kind, refId])
  @@map("schedule_event_share_scopes")
}

/// 공휴일 — 임시공휴일/대체공휴일 등 관리자가 등록(내장 기본값을 덮어씀)
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(100)
  type      String   @default("temporary") @db.VarChar(20) // temporary(임시) | substitute(대체) | legal(법정) | etc
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("holidays")
}

model WbsProject {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(200)
  startDate   DateTime?          @map("start_date") @db.Date
  endDate     DateTime?          @map("end_date") @db.Date
  description String?
  createdBy   Int                @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  issues      WbsIssue[]
  members     WbsProjectMember[]
  tasks       WbsTask[]
  creator     User               @relation("WbsProjectCreator", fields: [createdBy], references: [id])

  @@map("wbs_projects")
}

model WbsProjectMember {
  id         Int        @id @default(autoincrement())
  projectId  Int        @map("project_id")
  role       String     @db.VarChar(50)
  memberName String     @map("member_name") @db.VarChar(100)
  order      Int        @default(0)
  project    WbsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("wbs_project_members")
}

model WbsTask {
  id              Int        @id @default(autoincrement())
  projectId       Int        @map("project_id")
  parentId        Int?       @map("parent_id")
  level           Int        @default(0)
  order           Int        @default(0)
  name            String     @db.VarChar(200)
  deliverable         String?    @db.VarChar(200)
  deliverableFile     String?    @map("deliverable_file") @db.VarChar(500)
  deliverableOrigName String?    @map("deliverable_orig_name") @db.VarChar(500)
  startDate       DateTime?  @map("start_date") @db.Date
  endDate         DateTime?  @map("end_date") @db.Date
  plannedProgress Decimal    @default(0) @map("planned_progress") @db.Decimal(5, 2)
  actualProgress  Decimal    @default(0) @map("actual_progress") @db.Decimal(5, 2)
  memo            String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  parent          WbsTask?   @relation("WbsTaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children        WbsTask[]  @relation("WbsTaskChildren")
  project         WbsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("wbs_tasks")
}

model WbsIssue {
  id           Int            @id @default(autoincrement())
  projectId    Int            @map("project_id")
  category     String?        @db.VarChar(100)
  content      String
  occurDate    DateTime?      @map("occur_date") @db.Date
  targetDate   DateTime?      @map("target_date") @db.Date
  progress     Decimal        @default(0) @db.Decimal(5, 2)
  expectedDate DateTime?      @map("expected_date") @db.Date
  status       WbsIssueStatus @default(open)
  note         String?
  createdBy    Int            @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  project      WbsProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User           @relation("WbsIssueCreator", fields: [createdBy], references: [id])

  @@map("wbs_issues")
}

model RecurringTask {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(200)
  description     String?
  partId          Int?           @map("part_id")
  priority        Priority       @default(normal)
  recurrenceType  RecurrenceType @map("recurrence_type")
  recurrenceDay   Int?           @map("recurrence_day")
  recurrenceEnd   DateTime?      @map("recurrence_end") @db.Date
  assigneeIdsJson String?        @map("assignee_ids_json")
  extraNamesJson  String?        @map("extra_names_json")
  isActive        Boolean        @default(true) @map("is_active")
  createdBy       Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  creator         User           @relation(fields: [createdBy], references: [id])
  part            Team?          @relation(fields: [partId], references: [id])
  generatedTasks  Task[]

  @@map("recurring_tasks")
}

model TaskTemplate {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  title           String   @db.VarChar(200)
  description     String?
  partId          Int?     @map("part_id")
  priority        Priority @default(normal)
  durationDays    Int?     @map("duration_days")
  assigneeIdsJson String?  @map("assignee_ids_json")
  extraNamesJson  String?  @map("extra_names_json")
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
